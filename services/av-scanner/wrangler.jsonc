// casevoya-av-scanner: ClamAV virus scanning for uploads (#263-B) in a Cloudflare Container.
// NOT DEPLOYED. A separate Worker from casevoya-app; the app reaches it only through its service
// binding "AV_SCANNER" (see docs/integrations/av-scanner.md). No route, no workers.dev URL, no
// secrets: the container receives a file's bytes and answers clean, infected or error.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "casevoya-av-scanner",
  "main": "runtime/worker.ts",
  "account_id": "c8010438fc56280e3ea5747a123e818a",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "AvScannerContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      // clamd's loaded engine is about 1.7 GiB (ClamAV, Dec 2025). basic (1 GiB) cannot hold it.
      // standard-1 is 4 GiB / 1/2 vCPU / 8 GB disk (https://developers.cloudflare.com/containers/platform/limits/,
      // read 2026-10-29). That fits the one engine. freshclam must not test a second copy
      // (freshclam.conf TestDatabases no; clamd.conf ConcurrentDatabaseReload no). If a deploy's
      // logs show clamd killed, move this to standard-2 (6 GiB, 1 vCPU) and redeploy the scanner
      // before turning scanning on. The 0-healthy failure was the startup check, not this size.
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AV_SCANNER", "class_name": "AvScannerContainer" }]
  },
  "exports": {
    "AvScannerContainer": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
