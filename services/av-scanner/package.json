{
  "name": "casevoya-av-scanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virus scanning for uploads (#263-B): ClamAV in a Cloudflare Container behind the casevoya-av-scanner Worker. Not deployed.",
  "engines": { "node": ">=20" },
  "scripts": {
    "bundle": "esbuild runtime/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:dry": "pnpm bundle && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
