# Copy to .env.local. Never commit real values.
# Public (sent to the browser): project URL + publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://aqjtvqmojfamtspzyeqm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Stripe, TEST MODE ONLY. Live keys are refused. Absent: the Payments pages say card payments aren't configured.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# The signed-in app uses the publishable key. Mail dispatch and inbound intake use the secret key.
# SUPABASE_SECRET_KEY=

# Stripe test-mode secret key and the Connect webhook destination's signing secret.
# STRIPE_TEST_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# Signing secret of the platform-account event destination for Casevoya subscription billing (/api/stripe/billing).
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxx
# Optional: none (default, embedded components only) or full (also the Stripe Dashboard).
# STRIPE_CONNECT_DASHBOARD=none

# Cloudflare Email Sending. The token is never committed. Account id is not a secret.
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=c8010438fc56280e3ea5747a123e818a
# CLOUDFLARE_EMAIL_FROM=notices@casevoya.ca

# Email Routing rules for <firm-slug>@docs.casevoya.ca. Separate from the sending token.
# Zone 303990065795d627a9fd337b01258024 is on the account above. The rules API is zone-scoped.
# CLOUDFLARE_ROUTING_API_TOKEN=
# Bearer for POST /api/email/routing/reconcile.
# EMAIL_ROUTING_RECONCILE_SECRET=

# Inbound domain for <firm-slug>@ and matter plus-tags. Default docs.casevoya.ca.
# INBOUND_EMAIL_DOMAIN=docs.casevoya.ca

# Bearer secret for POST /api/email/dispatch, and the HMAC secret shared with the inbound Worker.
# EMAIL_DISPATCH_SECRET also derives (HKDF, separate labels) the key that seals invitation links
# in the outbox and the scheduler bearer. Optional CRON_SECRET replaces it as the scheduler bearer
# (docs/DEPLOY.md).
# EMAIL_DISPATCH_SECRET=
# CRON_SECRET=
# EMAIL_INBOUND_WEBHOOK_SECRET=

# Optional. Origin used in invitation email links. Default https://app.casevoya.ca.
# APP_URL=http://localhost:3000
