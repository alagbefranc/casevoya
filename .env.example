# Copy to .env.local. Never commit real values.
# Public (sent to the browser): project URL + publishable key only.
NEXT_PUBLIC_SUPABASE_URL=https://aqjtvqmojfamtspzyeqm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. When set, /portal/pay mounts Stripe's Payment Element. Absent: the designed card placeholder.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# The signed-in app uses the publishable key. Mail dispatch and inbound intake use the secret key.
# SUPABASE_SECRET_KEY=

# Cloudflare Email Sending. The token is never committed. Account id is not a secret.
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=c8010438fc56280e3ea5747a123e818a
# CLOUDFLARE_EMAIL_FROM=notices@casevoya.ca

# Inbound domain for <firm-slug>@ and matter plus-tags. Default docs.casevoya.ca.
# INBOUND_EMAIL_DOMAIN=docs.casevoya.ca

# Bearer secret for POST /api/email/dispatch, and the HMAC secret shared with the inbound Worker.
# EMAIL_DISPATCH_SECRET=
# EMAIL_INBOUND_WEBHOOK_SECRET=
