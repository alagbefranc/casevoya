{
  "name": "casevoya-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "email:previews": "vitest run tests/email-previews.test.ts -u",
    "db:types": "supabase gen types typescript --project-id aqjtvqmojfamtspzyeqm --schema public > src/types/database.types.ts",
    "verify": "pnpm check:migrations && pnpm lint && pnpm typecheck && pnpm test",
    "build:workers": "CASEVOYA_TARGET=workers opennextjs-cloudflare build",
    "deploy:app": "pnpm run build:workers && opennextjs-cloudflare deploy",
    "deploy:inbound": "wrangler deploy --config workers/inbound-email/wrangler.toml"
  },
  "dependencies": {
    "@stripe/connect-js": "3.4.6",
    "@stripe/react-connect-js": "3.4.4",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "postal-mime": "^4.0.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  }
}
