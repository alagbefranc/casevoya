// casevoya-app on Cloudflare Workers, built with OpenNext.
// Mirrors the live Worker's settings as of 2026-10-17. Secrets are set on the Worker
// with `wrangler secret put` and are never in this file; keep_vars leaves dashboard
// variables in place on deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casevoya-app",
  "main": ".open-next/worker.js",
  "account_id": "c8010438fc56280e3ea5747a123e818a",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "app.casevoya.ca", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Workers AI, for staff "Draft in French" machine drafts only (src/modules/i18n/translate.ts,
  // model @cf/meta/llama-3.3-70b-instruct-fp8-fast). Not available in next dev; no REST fallback.
  "ai": { "binding": "AI" },
  "services": [
    // OpenNext self-reference; the service name must match the Worker name.
    { "binding": "WORKER_SELF_REFERENCE", "service": "casevoya-app" },
    // Vo agent (Claude Agent SDK in a Cloudflare Container); requests are HMAC-signed with
    // VO_AGENT_SECRET (a Worker secret). See docs/integrations/vo-agent.md.
    { "binding": "VO_AGENT", "service": "casevoya-vo-agent" },
    // Virus scanner (#263-B, ClamAV in a Cloudflare Container, services/av-scanner). Deploy
    // `casevoya-av-scanner` before the app (docs/integrations/av-scanner.md). Uploads stay
    // type-checked only until the product setting documents.accept_structural_inspection is false.
    { "binding": "AV_SCANNER", "service": "casevoya-av-scanner" },
  ],
  // Workers Rate Limiting (src/lib/security/rate-limit.ts). Per Cloudflare location and approximate;
  // the database counters (app.auth_attempts, booking and enquiry limits) are the hard layer.
  "ratelimits": [
    // Password sign-in, sign-up, invitation sign-in/sign-up; per visitor address.
    { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
    // Anything that makes Supabase send an email; per visitor address.
    { "name": "RL_AUTH_EMAIL", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
    // Email codes, invitation codes, TOTP; per visitor address and per signed-in user.
    { "name": "RL_VERIFY", "namespace_id": "2003", "simple": { "limit": 15, "period": 60 } },
    // Public booking hold and enquiry POSTs; per visitor address.
    { "name": "RL_PUBLIC", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
    // Invoice card payment, subscription checkout and billing portal; per user.
    { "name": "RL_PAYMENT", "namespace_id": "2005", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://aqjtvqmojfamtspzyeqm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_WJL1a16TYhbj2HETogqpLQ_RcbYs1vH"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true }
  }
}
